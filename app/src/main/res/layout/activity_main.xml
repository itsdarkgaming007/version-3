<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header & Engine Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="QuickSender Pro"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEngineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1F2C34"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Engine: Offline"
                android:textColor="#FFA000"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SECTION 1: WhatsApp Device Linking -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#111B21"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Link WhatsApp Account"
                    android:textColor="#00A884"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pair directly using an 8-digit code (no QR scan needed)"
                    android:textColor="#8696A0"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etSenderPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="#202C33"
                    android:hint="Your WhatsApp No (e.g. 919876543210)"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8696A0"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnGenerateCode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#00A884"
                    android:text="Get 8-Digit Pairing Code"
                    android:textColor="#111B21"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPairingCodeResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="#25D366"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECTION 2: Group & Contact Manager -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#111B21"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Contacts &amp; Groups"
                    android:textColor="#00A884"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etGroupName"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="#202C33"
                        android:hint="New Group Name"
                        android:paddingHorizontal="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8696A0"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnCreateGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#202C33"
                        android:text="Create"
                        android:textColor="#00A884" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/spGroups"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="#202C33" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etContactNumber"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="#202C33"
                        android:hint="Add Number (e.g. 919876543210)"
                        android:inputType="phone"
                        android:paddingHorizontal="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8696A0"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnAddNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#202C33"
                        android:text="+ Add"
                        android:textColor="#00A884" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGroupMembersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Numbers in selected group: 0"
                    android:textColor="#8696A0"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECTION 3: Silent Background Dispatcher -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#111B21"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Silent Bulk Broadcast"
                    android:textColor="#00A884"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBroadcastMessage"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="10dp"
                    android:background="#202C33"
                    android:gravity="top|start"
                    android:hint="Type your bulk message here..."
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8696A0"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnStartBulkSend"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#00A884"
                    android:text="Start Silent Broadcast"
                    android:textColor="#111B21"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBroadcastProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textColor="#25D366"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
