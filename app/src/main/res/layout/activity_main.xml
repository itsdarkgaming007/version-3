<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141B">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F2C34">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/mainToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QuickSender Pro"
                    android:textColor="#E9EDEF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="#AEBAC1" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 1. EMPTY STATE (When 0 groups exist) -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Groups Created Yet"
                android:textColor="#E9EDEF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Tap the + button to create a group (up to 300 members per group)"
                android:textColor="#8696A0"
                android:textSize="13sp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCreateFirstGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:backgroundTint="#00A884"
                android:src="@android:drawable/ic_input_add"
                app:elevation="6dp"
                app:fabCustomSize="64dp"
                app:tint="#111B21" />
        </LinearLayout>

        <!-- 2. ACTIVE CAMPAIGN WORKSPACE -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutWorkspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Audience / Group Selection Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1F2C34"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvTargetGroupLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Target Group"
                                android:textColor="#00A884"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnAddNumbersModal"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:backgroundTint="#00A884"
                                android:text="+ Add Numbers"
                                android:textColor="#111B21"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Spinner
                            android:id="@+id/spGroups"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:background="#111B21" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvGroupStats"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0 / 300 members"
                                android:textColor="#8696A0"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/btnViewMembersList"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="4dp"
                                android:text="Manage Members ➔"
                                android:textColor="#53BDEB"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Message & Media Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#1F2C34"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvMessageLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Message Content"
                            android:textColor="#00A884"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etMessageInput"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="8dp"
                            android:background="#111B21"
                            android:gravity="top|start"
                            android:hint="Type message or media caption..."
                            android:padding="10dp"
                            android:textColor="#E9EDEF"
                            android:textColorHint="#8696A0"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btnAttachMedia"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:backgroundTint="#111B21"
                                android:text="📎 Attach Media"
                                android:textColor="#E9EDEF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvMediaStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="No file attached"
                                android:textColor="#8696A0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- WhatsApp Real-Time Chat Bubble Preview -->
                        <TextView
                            android:id="@+id/tvPreviewLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="WhatsApp Live Preview"
                            android:textColor="#8696A0"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="#0B141B"
                            android:gravity="end"
                            android:padding="10dp">

                            <LinearLayout
                                android:id="@+id/layoutPreviewBubble"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="36dp"
                                android:background="#005C4B"
                                android:orientation="vertical"
                                android:padding="6dp">

                                <ImageView
                                    android:id="@+id/ivPreviewMedia"
                                    android:layout_width="220dp"
                                    android:layout_height="140dp"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvPreviewText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="4dp"
                                    android:layout_marginTop="4dp"
                                    android:maxWidth="220dp"
                                    android:text="Hello, preview here..."
                                    android:textColor="#E9EDEF"
                                    android:textSize="14sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:id="@+id/tvPreviewTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="09:30 PM"
                                        android:textColor="#8696A0"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="✓✓"
                                        android:textColor="#53BDEB"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Per-Group Anti-Ban Delay Control -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#1F2C34"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvAntiBanLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anti-Ban Speed Control"
                            android:textColor="#00A884"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDelayDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Delay: 6 to 11 seconds (Human Behavior)"
                            android:textColor="#8696A0"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/sbDelay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="25"
                            android:progress="6" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Start Broadcast Trigger -->
                <Button
                    android:id="@+id/btnStartDispatch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp"
                    android:backgroundTint="#00A884"
                    android:text="Start Broadcast"
                    android:textColor="#111B21"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- New Group Floating Action Button (Always Accessible) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddGroupCorner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:backgroundTint="#00A884"
            android:src="@android:drawable/ic_input_add"
            app:tint="#111B21" />

    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
