<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPillLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#E6111B21"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLiveProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0"
            android:textColor="#25D366"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbMicroProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="70dp"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00A884" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="10dp"
        android:background="#2A3942" />

    <ImageButton
        android:id="@+id/btnPauseResume"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="#202C33"
        android:contentDescription="Pause or Resume"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_pause" />

    <ImageButton
        android:id="@+id/btnCancelCampaign"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="#3A1D20"
        android:contentDescription="Cancel Campaign"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

</LinearLayout>
